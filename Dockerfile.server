FROM golang:1.27@sha256:65b6f280bf050ec5af12716857e8ea8439d694dbba8f31ceeb7630670071f2bb AS builder

# Build arguments for version information
ARG VERSION=dev
ARG BUILD_DATE
ARG GIT_COMMIT

WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w \
    -X github.com/PhilipSchmid/flow-generator-app/internal/version.Version=${VERSION} \
    -X github.com/PhilipSchmid/flow-generator-app/internal/version.BuildDate=${BUILD_DATE} \
    -X github.com/PhilipSchmid/flow-generator-app/internal/version.GitCommit=${GIT_COMMIT}" \
    -o echo-server ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w \
    -X github.com/PhilipSchmid/flow-generator-app/internal/version.Version=${VERSION} \
    -X github.com/PhilipSchmid/flow-generator-app/internal/version.BuildDate=${BUILD_DATE} \
    -X github.com/PhilipSchmid/flow-generator-app/internal/version.GitCommit=${GIT_COMMIT}" \
    -o dashboard ./cmd/dashboard
FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /app/echo-server /
COPY --from=builder /app/dashboard /
USER 65532:65532
ENTRYPOINT ["/echo-server"]
